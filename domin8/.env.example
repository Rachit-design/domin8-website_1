# ──────────────────────────────────────────────────────────────────────────
# Domin8 Esports — environment configuration
#
# Copy this file to ".env" and fill in your real values.
#   cp .env.example .env
#
# IMPORTANT: never commit your real .env to git. (.gitignore already excludes it.)
# ──────────────────────────────────────────────────────────────────────────

# Port the web server listens on.
PORT=3000

# ── iCafeCloud API ─────────────────────────────────────────────────────────
# Leave ICAFE_TOKEN and ICAFE_CAFE_ID BLANK to run in DEMO mode (fake but
# realistic PC numbers). Fill them in to switch to LIVE data — no code change.
#
# How to get these (from the iCafeCloud panel, Admin account only):
#   1. Log in at https://cp.icafecloud.com  with the primary Admin account.
#   2. Settings -> API settings.
#   3. In "API Access IP", enter the STATIC public IP of THIS server / VPS.
#      (The token is bound to that IP. Localhost testing from a home/dynamic
#       IP usually will NOT work — run live mode on your VPS.)
#   4. Click "Create"/"Generate". Copy the token immediately — it is shown once.
#
# Your Cafe ID is on your license/billing info in the same panel.

ICAFE_BASE_URL=https://api.icafecloud.com
ICAFE_CAFE_ID=
ICAFE_TOKEN=

# Total PCs in the venue. Used for demo mode and as a sanity fallback.
TOTAL_PCS=20

# How long (milliseconds) to cache a status response before re-fetching.
# Keep this >= 10000. iCafeCloud allows 200 requests/minute; caching protects
# you no matter how many people visit the site at once.
CACHE_TTL_MS=15000

# ── Contact form delivery (optional) ────────────────────────────────────────
# If set, contact form submissions are posted to this Discord webhook.
# Create one in: Discord server -> Channel settings -> Integrations -> Webhooks.
CONTACT_DISCORD_WEBHOOK=
